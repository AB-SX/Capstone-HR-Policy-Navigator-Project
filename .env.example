# Copy to .env and fill in. Never commit .env.

# --- Course LLM (Qwen3-8B on vLLM) ---
QWEN_API_KEY=enter-your-upgrad-api-key-here
QWEN_BASE_URL=https://103.42.50.41:1034/v1
QWEN_MODEL=Qwen/Qwen3-8B

# --- Course embeddings (bge-small-en-v1.5) ---
EMBEDDING_API_KEY=enter-your-embedding-api-key-here
EMBEDDING_BASE_URL=https://103.42.50.41:1035/v1

# TLS: the course endpoint uses a private (Caddy) CA. We trust it explicitly instead of verify=False.
COURSE_CA_CERT=certs/vm04-ca.crt
# COURSE_TLS_INSECURE=1   # last resort only

# --- Pinecone ---
PINECONE_API_KEY=enter-your-pinecone-api-key-here
PINECONE_INDEX=hr-policy-navigator

# --- LangSmith tracing (free account at smith.langchain.com) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hrnav-dev

# --- App: access code shown to reviewers (leave empty to disable the gate locally) ---
HRNAV_ACCESS_CODE=change-me
# Usage page at ?admin=1 (leave empty to turn it off)
HRNAV_ADMIN_CODE=
# HR request review page at ?hr=1 (leave empty to turn it off)
HRNAV_HR_CODE=
# 1 = team/demo view (M1/M2 switch, "how it answered"); leave empty for employees
HRNAV_DEV_MODE=
# Which assistant employees use: m2 (default) or m1
HRNAV_SYSTEM=m2
# 1 = show the handbook owner's name in answers; empty = shown as "the company"
HRNAV_SHOW_ORG=
# --- Deployment (server .env only) ---
# Elastic IP with dots -> dashes, plus .sslip.io, e.g. 13-54-12-34.sslip.io (Caddy gets a free HTTPS certificate)
SITE_ADDRESS=
LANGSMITH_PROJECT_PROD=hrnav-prod
